# Where Next.js forwards /api/* requests (server-side). Django's address.
BACKEND_URL=http://127.0.0.1:8000

# Leave unset to use the built-in proxy (recommended). Only set this if the browser
# should call Django directly, e.g. https://api.example.com/api - then also add this
# site's origin to CORS_ALLOWED_ORIGINS on the backend.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Dev only: your computer's LAN IP, when opening the dev server from a phone
# ALLOWED_DEV_ORIGINS=192.168.1.20

# ISO 4217 code used to format prices, e.g. USD, EUR, TND
NEXT_PUBLIC_CURRENCY=USD

# Hardware barcode scanners type like a keyboard. Set to "false" to hide the
# manual barcode box so items can ONLY be scanned with the camera.
NEXT_PUBLIC_ALLOW_MANUAL_ENTRY=true
