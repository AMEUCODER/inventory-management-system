# Copy to .env and edit. Never commit the real .env file.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Decides what "today" means on the dashboard, e.g. Africa/Tunis
DJANGO_TIME_ZONE=UTC
# Only needed if the browser calls this server directly (not through the Next.js proxy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production behind a TLS-terminating proxy: leave at 1. Set 0 only if you have no HTTPS.
DJANGO_SSL_REDIRECT=1
